{
  "name": "quiet-desk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "description": "Windows desktop-host feasibility spike for QuietDesk",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:platform": "npm run build && vitest run tests/platform",
    "build": "electron-vite build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.2": true
  }
}
